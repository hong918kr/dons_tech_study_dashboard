# TOOL-B02 solution.flags — project warning baseline (clang AND gcc).
# One flag (or flag + argument) per line; '#' starts a comment.
# check.sh compiles bugs12.c with these flags (every BUGnn line must get a
# diagnostic) and good.c with these flags + -Werror (must be silent).
# --- the six that catch bugs12.c (12/12) ---
-Wall                    # BUG01 (-Wsometimes-uninitialized) + default-on ones
-Wextra                  # BUG02 -Wsign-compare
-Wshadow                 # BUG03
-Wconversion             # BUG05 (+ BUG06: in C it implies -Wsign-conversion)
-Wimplicit-fallthrough   # BUG09 (gcc: already in -Wextra, clang: not)
-Wswitch-enum            # BUG12 (missing enumerator even with default:)
# --- baseline extras: nothing in bugs12.c needs them, good.c stays clean ---
-Wsign-conversion        # explicit: C++ files sharing this list need it
-Wformat=2               # + -Wformat-nonliteral (log wrappers)
-Wstrict-prototypes      # int f() is not a prototype in C11
-Wmissing-prototypes     # non-static function without a header declaration
-Wundef                  # #if TYPO_MACRO silently evaluates to 0
# --- code we do not own: system include dir => its warnings are not ours ---
-isystem third_party
