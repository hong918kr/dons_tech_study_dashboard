# TOOL-B02 practice.flags — stricter "firmware" set = baseline + 6 more.
# Must still flag all of bugs12.c, flag all six FWnn lines in fw_bugs.c,
# and keep good.c silent under -Werror.
-Wall
-Wextra
-Wshadow
-Wconversion
-Wimplicit-fallthrough
-Wswitch-enum
-Wsign-conversion
-Wformat=2
-Wstrict-prototypes
-Wmissing-prototypes
-Wundef
# --- firmware additions ---
-Wdouble-promotion       # FW01 float math silently done in double (soft-float on M4)
-Wvla                    # FW02 stack size depends on runtime n
-Wcast-align             # FW03 uint8_t* -> uint32_t* (gcc: only on strict-align targets)
-Wcast-qual              # FW04 casting away const of a Flash table
-Wpointer-arith          # FW05 arithmetic on void*
-Wwrite-strings          # FW06 string literal into char* (literal lives in Flash)
-isystem third_party
