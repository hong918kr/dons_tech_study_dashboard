# TOOL-M13 practice.flags — 더 작은 부품(Flash 2 KB)으로 옮기는 연습. practice.ld 와 짝.
# 키는 starter/solution 과 같다 (CFLAGS / LDFLAGS / AR).
# 연습 예산: text ≤ 1600 B, data ≤ 32 B, bss ≤ 256 B, LTO 사용, practice.ld 의 FLASH 영역 ≤ 2 KB,
#            링크 로그에 --print-memory-usage 표. 출력은 여전히 golden_uart.txt 와 같아야 한다.
CFLAGS  = -Os -g -ffunction-sections -fdata-sections -flto -DCRC_NIBBLE   # LTO + 64 B CRC 표
LDFLAGS = -Wl,--gc-sections -Wl,--print-memory-usage
AR      = arm-none-eabi-gcc-ar # LTO 객체(.o 안이 GIMPLE)의 심볼 색인을 만들 수 있는 유일한 선택
