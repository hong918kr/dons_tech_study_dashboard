# TOOL-B10 demo_debug.lldb — 2단계: 의심 함수에 breakpoint, 한 줄씩 진행 (Part A)
#   lldb -b -s demo_debug.lldb -- ./starter_dbg delete_head
settings set stop-line-count-before 1
settings set stop-line-count-after 1
b list_delete
run
bt
frame variable
n
n
p cur
p *cur
p cur->next->value
p prev
n
n
n
s
bt 2
finish
p *cur
up
p l
p *l.head
down
c
bt
frame select 1
p l.head
p *l.head
