# TOOL-B10 demo_delete_all.lldb — Part B 버그 1: 크래시 지점 = 버그 지점 (해제한 노드의 next 를 따라감)
#   lldb -b -s demo_delete_all.lldb -- ./starter_dbg delete_all_mixed
settings set stop-line-count-before 1
settings set stop-line-count-after 1
settings set auto-confirm true
run
bt 2
frame variable
p *prev
breakpoint set -p "prev = cur;" -X list_delete_all
run
frame variable removed cur
p *cur
display cur
n
n
n
