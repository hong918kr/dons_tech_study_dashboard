# TOOL-B10 demo_prev.lldb — Part B 버그 2: 버그 1만 고친 중간 상태 + -DVERIFY
#   lldb -b -s demo_prev.lldb -- ./midfix_dbg delete_all_mixed
settings set stop-line-count-before 1
settings set stop-line-count-after 1
settings set auto-confirm true
run
bt
frame select 3
p *l
p *l->head
p *l->head->next
breakpoint set -p "prev->next = next;" -X list_delete_all
run
frame variable value prev cur
p *prev
c
frame variable prev cur
p *prev
