# TOOL-B10 demo_verify.lldb — Part C: -DVERIFY 빌드는 버그 난 함수 안에서 멈춘다
#   lldb -b -s demo_verify.lldb -- ./verify_dbg delete_head     (starter 의 버그 + solution 의 list_check)
settings set stop-line-count-before 1
settings set stop-line-count-after 1
run
bt
frame select 3
frame variable
p *l
p l->head->next
