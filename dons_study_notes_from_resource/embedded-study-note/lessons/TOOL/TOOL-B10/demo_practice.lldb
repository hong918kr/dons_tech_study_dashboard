# TOOL-B10 demo_practice.lldb — 추가 연습 1: list_nth off-by-one 을 lldb 로
#   lldb -b -s demo_practice.lldb -- ./pbug nth
settings set stop-line-count-before 1
settings set stop-line-count-after 1
settings set auto-confirm true
run
bt 2
frame variable i sum l.len
b list_nth
run
thread until 32
frame variable idx n
p *n
c
thread until 32
frame variable idx
p *n
c
frame variable idx
finish
c
