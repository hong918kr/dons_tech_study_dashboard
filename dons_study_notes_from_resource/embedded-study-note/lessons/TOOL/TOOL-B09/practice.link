# TOOL-B09 link lines + predictions (sourced by check.sh; bash syntax)
# Only the RHS of each line may change. Libraries are built by check.sh in the work dir:
#   libfoo.a = foo_a.o foo_b.o foo_unused.o     libbar.a = bar_a.o bar_unused.o
#   libcrc_fast.a = crc_fast.o                  libcrc_ref.a = crc_ref.o crc_vectors.o
#   libuart.a = uart_hw.o uart_retarget.o       (Cortex-M, arm-none-eabi-gcc)

# ---- Part A: predict ok|fail for each link (replace every ?) ----------------------
# Apple ld64 (Mac):  cc <line> -o app
PRED_LD64_FOO_BAR=ok       # main.o -L. -lfoo -lbar
PRED_LD64_BAR_FOO=ok       # main.o -L. -lbar -lfoo
PRED_LD64_LIBS_FIRST=ok    # -L. -lfoo -lbar main.o
# GNU ld.bfd (VM):    gcc -fuse-ld=bfd <line> -o app
PRED_BFD_FOO_BAR=fail      # main.o -L. -lfoo -lbar
PRED_BFD_BAR_FOO=fail      # main.o -L. -lbar -lfoo
PRED_BFD_BAR_FOO_BAR=fail  # main.o -L. -lbar -lfoo -lbar
PRED_BFD_LIBS_FIRST=fail   # -L. -lfoo -lbar main.o
# LLVM ld.lld (VM):   gcc -fuse-ld=lld <line> -o app
PRED_LLD_BAR_FOO=ok        # main.o -L. -lbar -lfoo
PRED_LLD_LIBS_FIRST=ok     # -L. -lfoo -lbar main.o

# ---- Part A: make it link with GNU ld.bfd; pull ONLY the members that are needed -----
A_GNU="main.o -L. -Wl,--start-group -lfoo -lbar -Wl,--end-group"   # group: rescan until no new undefined

# ---- Part B: crc32 must come from libcrc_fast.a, test vectors from libcrc_ref.a ------
# keep both libraries on the line; no -all_load / -force_load / --whole-archive
B_MAC="main_b.o -L. -lcrc_fast -lcrc_ref"            # objects first, preferred lib first
B_GNU="main_b.o -L. -lcrc_fast -lcrc_ref"            # (used for bfd AND lld)

# ---- Part C: Cortex-M firmware; printf() must reach libuart.a's _write() ------------
# arm-none-eabi-gcc -mcpu=cortex-m4 -mthumb --specs=nano.specs --specs=nosys.specs <line>
# libuart.a is a vendor drop: you get the archive only (no loose uart_*.o)
C_GNU="fw_main.o -L. -Wl,--whole-archive -luart -Wl,--no-whole-archive"   # every libuart member

# ---- Practice: self-registering tests in libtests.a (no symbol references them) -----
P_MAC="main_p.o -Wl,-force_load,./libtests.a"
P_GNU="main_p.o -L. -Wl,--whole-archive -ltests -Wl,--no-whole-archive"
