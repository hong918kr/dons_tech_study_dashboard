{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host unit tests (Apple clang)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host"
    },
    {
      "name": "target",
      "displayName": "Cortex-M4 firmware, board rev 2",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/target",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "BOARD_REV": "2", "FW_MCU": "cortex-m4" }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" },
    { "name": "target", "configurePreset": "target" }
  ],
  "testPresets": [
    { "name": "host", "configurePreset": "host", "output": { "outputOnFailure": true } }
  ]
}
