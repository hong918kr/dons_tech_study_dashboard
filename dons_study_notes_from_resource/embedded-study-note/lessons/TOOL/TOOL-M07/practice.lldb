# TOOL-M07 practice.lldb — 같은 사냥을 -c 문자열 대신 파이썬 콜백으로 (practice.py 의 ③④)
#   cc -std=c11 -g -O0 buggy.c -o buggy && cp practice.py ringbuf_cmd.py && lldb -b -s practice.lldb ./buggy
command script import ringbuf_cmd.py
breakpoint set -n main
run
# ① 하드웨어 워치포인트 + 파이썬 조건 콜백: 0..3 밖의 값이 써질 때만 True(멈춤)
watchpoint set variable dev.link_state
watchpoint command add -F ringbuf_cmd.wp_bad_link_state 1
continue
# ② 멈춘 PC 는 쓰기 "다음" 명령어 → 범인은 PC 바로 앞 명령어
bt 3
image lookup -a $pc-4
p g_tick
p/x dev.link_state
rbdump rb
rbcheck rb
memory read -s1 -fx -c 20 &dev.tx.buf[0]
# ③ 워치포인트를 지우고, 파이썬 BP 콜백으로 두 번째 사건(증상을 낸 것)에서 멈춘다
watchpoint delete 1
breakpoint set -n rb_put_escaped
breakpoint command add -F ringbuf_cmd.bp_edge 2
continue
p g_tick
frame variable -Y1 -f x *rb
continue
