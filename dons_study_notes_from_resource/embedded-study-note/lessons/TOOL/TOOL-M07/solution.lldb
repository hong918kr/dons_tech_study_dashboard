# TOOL-M07 solution.lldb — dev.link_state 를 망가뜨리는 범인 줄을 디버거만으로 찾는다
#   cc -std=c11 -g -O0 buggy.c -o buggy && cp solution.py ringbuf_cmd.py && lldb -b -s solution.lldb ./buggy
command script import ringbuf_cmd.py
breakpoint set -n main
run
# ① 로깅 BP: 위험한 경로(마지막 칸 head == 15 에서 2바이트 escape)를 멈추지 않고 기록만 (-G = auto-continue)
breakpoint set -n rb_put_escaped -c 'rb->head == 15' -G true -C 'p g_tick' -C 'p *rb'
# ② 하드웨어 워치포인트: 이웃 필드에 "있을 수 없는 값"(0..3 밖)이 써지는 순간에만 멈춘다
watchpoint set variable dev.link_state
watchpoint modify -c 'dev.link_state > 3'
continue
# ③ 멈춘 PC 는 쓰기 "다음" 명령어 → 범인은 PC 바로 앞 명령어
bt 3
image lookup -a $pc-4
p g_tick
p/x dev.link_state
rbdump rb
memory read -s1 -fx -c 20 &dev.tx.buf[0]
# ④ 워치포인트를 지우고 끝까지: 로깅 BP 가 두 번째 사건(증상을 낸 것)을 기록한다
watchpoint delete 1
continue
