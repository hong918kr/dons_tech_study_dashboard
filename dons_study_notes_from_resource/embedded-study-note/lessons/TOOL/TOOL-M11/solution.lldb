# TOOL-M11 post-mortem script (solution) — check.sh runs it as:
#     lldb -b -c /cores/core.<pid> <work>/crash -s solution.lldb
# On a core there is no live process: nothing can run, and `lldb -b` STOPS at the
# first command that fails. Every line below must succeed.

# ---- 1. which thread died, where, and why ----
thread list
thread info
bt
register read pc lr sp far esr
frame variable
frame select 1
frame variable self->name

# ---- 2. the heap object the crashing code used ----
p *g_sess
memory read -c 48 g_sess

# ---- 3. who wrote the bad bytes? ----
thread select 4
frame select 2
frame variable self->name last_len p
p g_trace

# ---- 4. how long is the name now? ----
p sizeof(g_sess->name)
script print("POSTMORTEM-END")
