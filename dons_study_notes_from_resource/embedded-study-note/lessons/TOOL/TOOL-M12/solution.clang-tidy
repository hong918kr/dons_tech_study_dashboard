# solution.clang-tidy - CI baseline for the firmware C code (clang-tidy 23.1.4)
# Families chosen by measurement: each one either finds a real bug class in
# fw_bugs.c or costs 0 findings on fw_clean.c.  Style families (readability-*,
# modernize-*, cppcoreguidelines-*, misc-*, altera-*, llvmlibc-*) stay off.
# insecureAPI.DeprecatedOrUnsafeBufferHandling = 'use memcpy_s' (C11 Annex K,
# which newlib/glibc do not ship): flags every memcpy/snprintf -> off.
Checks: >-
  -*,
  clang-diagnostic-*,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  bugprone-*,
  cert-*,
  concurrency-*,
  performance-*,
  portability-*
# any finding fails the CI job (exit code 1)
WarningsAsErrors: '*'
# our headers yes, vendor headers no - and works for -Iinclude AND -I/abs/include
HeaderFilterRegex: '(^|/)include/'
# Clang thread-safety analysis rides along as a compiler warning
ExtraArgs: ['-Wthread-safety']
CheckOptions:
  # 1u << 13 is fine; flag signed operands that are not plain positive literals
  bugprone-signed-bitwise.IgnorePositiveIntegerLiterals: true
