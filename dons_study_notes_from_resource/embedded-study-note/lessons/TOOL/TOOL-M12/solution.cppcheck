# solution.cppcheck - cppcheck options, one per line (cppcheck 2.22)
# warning+style+performance+portability; not 'information' (missing system
# headers) and not 'unusedFunction' (needs the whole program, not one file)
--enable=warning,style,performance,portability
--std=c11
# honour the one-line '// cppcheck-suppress <id>' comments in the sources
--inline-suppr
# any finding fails the CI job
--error-exitcode=1
