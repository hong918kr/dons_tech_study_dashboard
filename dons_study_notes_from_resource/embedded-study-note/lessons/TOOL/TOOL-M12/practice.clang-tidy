# practice.clang-tidy - "clang-tidy only" runner (no cppcheck on the new CI image)
# solution.clang-tidy + two analyzer knobs passed through ExtraArgs:
#   -analyzer-max-loop 16           : walk loops up to 16 times (default 4)
#   suppress-null-return-paths=false: keep null derefs whose NULL came from an
#                                     inlined callee's 'return NULL'
Checks: >-
  -*,
  clang-diagnostic-*,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  bugprone-*,
  cert-*,
  concurrency-*,
  performance-*,
  portability-*
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)include/'
ExtraArgs:
  - '-Wthread-safety'
  - '-Xclang'
  - '-analyzer-max-loop'
  - '-Xclang'
  - '16'
  - '-Xclang'
  - '-analyzer-config'
  - '-Xclang'
  - 'suppress-null-return-paths=false'
CheckOptions:
  bugprone-signed-bitwise.IgnorePositiveIntegerLiterals: true
