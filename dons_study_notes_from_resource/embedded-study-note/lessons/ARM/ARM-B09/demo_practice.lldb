# ARM-B09 demo_practice.lldb — 연습 5: 조건부 브레이크포인트 + stop-hook 으로 자동 트레이스
#   cc -g -O0 demo_debug.c starter.S -o dbg && lldb -b -s demo_practice.lldb dbg
settings set stop-disassembly-count 1
settings set stop-line-count-before 0
settings set stop-line-count-after 0
breakpoint set -n my_strlen -c '*(unsigned char *)$x0 == 0'
target stop-hook add -o "register read x1 x2 cpsr"
run
register read x0
si
si
si
si
