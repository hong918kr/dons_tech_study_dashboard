# ARM-B09 demo_crash.lldb — Part C: 페이지 끝 "" 에서 죽는 버그 판을 크래시 덤프처럼 읽고,
#                            register write 로 "시작 포인터가 1 크다" 가설을 재빌드 없이 확인
#   cc -g -O0 demo_debug.c starter.S -o dbg && lldb -b -s demo_crash.lldb dbg
settings set stop-disassembly-count 3
settings set stop-line-count-before 0
settings set stop-line-count-after 0
# ---- 1) 크래시 재현: 멈춘 곳 = 원인 명령, 주소 = 가드 페이지 첫 바이트 ----
process launch -- crash
thread info
register read pc lr sp x0 x1 x2 cpsr
register read far esr
register read -f b cpsr
disassemble -s $pc -c 1
image lookup -a $pc
bt
memory read -s1 -fx -c1 $x0
memory read -s1 -fx -c1 $x1
process kill
# ---- 2) 가설 확인: my_strlen 첫 명령(mov x1, x0) 직후 x1 을 x0-1 로 바꿔 본다 ----
b my_strlen
process launch -- crash
si
register read x0 x1
register write x1 `$x0 - 1`
register read x1
breakpoint delete 1
continue
