# ARM-B09 demo_debug.lldb — 버그 판(starter.S) my_strlen 을 명령어 단위로 관찰
#   cc -g -O0 demo_debug.c starter.S -o dbg && lldb -b -s demo_debug.lldb dbg
settings set stop-disassembly-count 1
settings set stop-line-count-before 0
settings set stop-line-count-after 0
# ---- 1) si vs ni : two_lengths 안의 bl my_strlen ----
b demo_debug.c:25
run
ni
register read pc lr x0
ni
register read pc x0
ni
ni
register read pc x0
si
register read pc lr x0
disassemble -n my_strlen
# ---- 2) "" (main.empty) 에서: NUL 다음 바이트를 읽으면 멈추는 read watchpoint ----
memory read -s1 -fx -c8 $x0
watchpoint set expression -w read -s 1 -- $x0 + 1
continue
register read x0 x1 x2 cpsr
watchpoint delete 1
si
register read cpsr
si
register read pc
finish
register read x0
continue
