# ARM-B09 demo_trace.lldb — "abc" 한 번의 my_strlen 을 si 로 끝까지(ret 까지) 따라가며 x0/x1/x2/cpsr 기록
#   lldb -b -s demo_trace.lldb dbg      (starter.S 로 빌드 = 버그 판 → demo_trace_bug.txt)
#   lldb -b -s demo_trace.lldb fixed    (solution.S 로 빌드 = 고친 판 → demo_trace_fix.txt)
settings set stop-disassembly-count 1
settings set stop-line-count-before 0
settings set stop-line-count-after 0
b my_strlen
run
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
si
register read pc x0 x1 x2 cpsr
process kill
