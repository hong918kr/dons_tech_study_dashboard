# ARM-B11 demo: v0 의 뷰(v/q/d/s)를 lldb 로 직접 본다 (lldb 심화 = ARM-B09)
#   cc -std=c11 -g -O0 harness.c solution.S shared_abi.S -o /tmp/ARM-B11_dbg
#   lldb -b -s demo_views.lldb /tmp/ARM-B11_dbg
# 이 맥의 lldb 는 h0/b0 이름은 모른다 (Invalid register name) → v/q/d/s 만.
b vreg_views
run
si
register read v0 d0 s0
si
register read v0 q0 d0 s0
register read -f x d0 s0
