# ARM-M14 demo_crash_uaf.lldb — 해제 후 사용 + MallocScribble (0x55 채우기) (make_dumps.sh 가 실행)
# macOS 27.2 실측: MallocScribble=1 만으로는 free 가 0 으로 지운다(zero-on-free) → MallocZeroOnFree=0 도 필요
settings set stop-disassembly-count 0
settings set stop-line-count-before 0
settings set stop-line-count-after 0
settings set target.env-vars MallocZeroOnFree=0 MallocScribble=1
process launch -- again
register read
register read far esr
disassemble -f
bt
memory read -fx -s8 -c6 $x0
image dump sections ARM-M14_uaf
process kill
