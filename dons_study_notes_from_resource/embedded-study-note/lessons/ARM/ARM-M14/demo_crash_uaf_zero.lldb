# ARM-M14 demo_crash_uaf.lldb — 해제 후 사용, 기본 할당자 (zero-on-free) (make_dumps.sh 가 실행)
settings set stop-disassembly-count 0
settings set stop-line-count-before 0
settings set stop-line-count-after 0
process launch -- again
register read
register read far esr
disassemble -f
bt
memory read -fx -s8 -c6 $x0
image dump sections ARM-M14_uaf
process kill
