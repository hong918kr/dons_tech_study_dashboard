# ARM-M14 demo_crash_stack.lldb — ret 이 덮인 LR 로 점프한 크래시 (make_dumps.sh 가 실행)
settings set stop-disassembly-count 0
settings set stop-line-count-before 0
settings set stop-line-count-after 0
process launch -- overrun
register read
register read far esr
process status -v
bt
memory read -f A -s 8 -c 12 `$sp - 0x50`
memory read -f c -c 48 `$sp - 0x20`
image dump sections ARM-M14_stack
# pc 가 코드가 아니면 디스어셈블이 실패한다 (lldb -b 는 첫 에러에서 멈추므로 맨 끝에 둔다)
disassemble -p -c 1
