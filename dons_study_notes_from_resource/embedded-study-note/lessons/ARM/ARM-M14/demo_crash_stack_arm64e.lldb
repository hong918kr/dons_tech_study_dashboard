# ARM-M14 demo_crash_stack_arm64e.lldb — 같은 오버런을 arm64e(PAC 켜짐)로 빌드하면 증상이 바뀐다
settings set stop-disassembly-count 0
settings set stop-line-count-before 0
settings set stop-line-count-after 0
process launch -- overrun
register read pc lr fp sp x16 x17 far esr
disassemble -f
bt
image dump sections ARM-M14_stack_e
process kill
