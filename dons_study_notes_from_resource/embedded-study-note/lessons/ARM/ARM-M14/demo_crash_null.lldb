# ARM-M14 demo_crash_null.lldb — NULL 멤버 접근 크래시를 "덤프"로 남긴다 (make_dumps.sh 가 실행)
settings set stop-disassembly-count 0
settings set stop-line-count-before 0
settings set stop-line-count-after 0
process launch -- 7
register read
register read far esr
disassemble -f
bt
image dump sections ARM-M14_null
process kill
