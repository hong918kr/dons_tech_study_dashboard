# ARM-B03 demo_trace.lldb — k_cafef00d_deadbeef / k_ffffffff_12345678 를 한 명령씩 실행하며 x0 관찰
#   cc -std=c11 -g -O0 solution.c solution.S shared_ref.S -o /tmp/ARM-B03_dbg
#   lldb -b -s demo_trace.lldb /tmp/ARM-B03_dbg
b k_cafef00d_deadbeef
b k_ffffffff_12345678
run
disassemble -n k_cafef00d_deadbeef
register read x0
si
register read x0
si
register read x0
si
register read x0
si
register read x0
continue
register read x0
si
register read x0
si
register read x0
kill
