# ARM-B06 demo: nibrev32(0x12345678) 를 명령 하나씩 실행하며 w0/w1 관찰
# cc -std=c11 -g -O2 harness.c solution.S shared_bugs.S -o /tmp/ARM-B06_dbg && lldb -b -s demo_trace.lldb /tmp/ARM-B06_dbg
b nibrev32
run
register read w0
si
register read w0
si
register read w0 w1
si
register read w0
si
register read w0
si
register read w0
kill
