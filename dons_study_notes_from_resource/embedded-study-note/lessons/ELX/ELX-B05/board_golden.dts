/dts-v1/;

/memreserve/	0x000000005ff00000 0x0000000000100000;
/ {
	model = "ESN B05 Virtual Board";
	compatible = "esn,b05-board";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;

	chosen {
		bootargs = "console=ttyAMA0,115200 root=/dev/vda rw";
		stdout-path = "serial0:115200n8";
	};

	aliases {
		serial0 = "/soc@0/serial@9000000";
		i2c0 = "/soc@0/i2c@9040000";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x01>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x20000000>;
	};

	interrupt-controller@8000000 {
		compatible = "arm,gic-400";
		reg = <0x00 0x8000000 0x00 0x1000 0x00 0x8010000 0x00 0x2000>;
		#interrupt-cells = <0x03>;
		interrupt-controller;
		phandle = <0x01>;
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0x10000000>;

		serial@9000000 {
			compatible = "arm,pl011", "arm,primecell";
			reg = <0x9000000 0x1000>;
			interrupts = <0x00 0x01 0x04>;
			status = "okay";
		};

		gpio@9030000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0x9030000 0x1000>;
			interrupts = <0x00 0x07 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x02>;
		};

		i2c@9040000 {
			compatible = "esn,b05-i2c";
			reg = <0x9040000 0x1000>;
			interrupts = <0x00 0x08 0x04>;
			clock-frequency = <0x61a80>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			temp-sensor@48 {
				compatible = "ti,tmp102";
				reg = <0x48>;
				interrupt-parent = <0x02>;
				interrupts = <0x05 0x02>;
			};

			eeprom@50 {
				compatible = "atmel,24c02";
				reg = <0x50>;
				pagesize = <0x08>;
			};
		};

		ethernet@9050000 {
			compatible = "esn,b05-eth";
			reg = <0x9050000 0x1000>;
			local-mac-address = [02 00 5e 10 00 01];
			status = "disabled";
		};
	};
};
