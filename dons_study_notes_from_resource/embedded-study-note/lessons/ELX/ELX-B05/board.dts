// ELX-B05 virtual board "esn,b05-board" — dtc -I dts -O dtb -o board.dtb board.dts
/dts-v1/;

/memreserve/ 0x5ff00000 0x100000;	/* 펌웨어용 1 MiB: 커널이 건드리지 않음 */

/ {
	model = "ESN B05 Virtual Board";
	compatible = "esn,b05-board";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&gic>;

	chosen {
		bootargs = "console=ttyAMA0,115200 root=/dev/vda rw";
		stdout-path = "serial0:115200n8";
	};

	aliases {
		serial0 = &uart0;
		i2c0 = &i2c0;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <1>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x20000000>;	/* 512 MiB */
	};

	gic: interrupt-controller@8000000 {
		compatible = "arm,gic-400";
		reg = <0x0 0x08000000 0x0 0x1000>,
		      <0x0 0x08010000 0x0 0x2000>;
		#interrupt-cells = <3>;
		interrupt-controller;
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x0 0x0 0x10000000>;

		uart0: serial@9000000 {
			compatible = "arm,pl011", "arm,primecell";
			reg = <0x09000000 0x1000>;
			interrupts = <0 1 4>;	/* SPI 1, level-high */
			status = "okay";
		};

		gpio0: gpio@9030000 {
			compatible = "arm,pl061", "arm,primecell";
			reg = <0x09030000 0x1000>;
			interrupts = <0 7 4>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		i2c0: i2c@9040000 {
			compatible = "esn,b05-i2c";
			reg = <0x09040000 0x1000>;
			interrupts = <0 8 4>;
			clock-frequency = <400000>;
			#address-cells = <1>;
			#size-cells = <0>;

			temp-sensor@48 {
				compatible = "ti,tmp102";
				reg = <0x48>;
				interrupt-parent = <&gpio0>;
				interrupts = <5 2>;	/* GPIO 5, IRQ_TYPE_EDGE_FALLING */
			};

			eeprom@50 {
				compatible = "atmel,24c02";
				reg = <0x50>;
				pagesize = <8>;
			};
		};

		ethernet@9050000 {
			compatible = "esn,b05-eth";
			reg = <0x09050000 0x1000>;
			local-mac-address = [02 00 5e 10 00 01];
			status = "disabled";
		};
	};
};
