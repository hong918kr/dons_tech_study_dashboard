# ELX-B13 dummy dependency (stands in for "i2c bus ready" / "sensor power rail on").
# check.sh installs it as /run/systemd/system/esn-b13-dep-@TAG@.service (runtime only).
[Unit]
Description=ELX-B13 dummy dependency (@TAG@)

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/echo esn-b13 dep up: sensor rail on
