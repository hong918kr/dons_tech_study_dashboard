# ELX-B13 fake sensor daemon unit. check.sh replaces @TAG@ / @W@ and installs it as
# /run/systemd/system/esn-b13-sensord-@TAG@.service (runtime only, removed on exit).
[Unit]
Description=ELX-B13 fake sensor daemon (@TAG@)
Wants=esn-b13-dep-@TAG@.service
After=esn-b13-dep-@TAG@.service
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
Type=notify
ExecStart=@W@/esn_sensord @W@/temp1_input @W@/hang
Restart=on-failure
RestartSec=1
WatchdogSec=5
TimeoutStartSec=4
TimeoutStopSec=5
