{
  "board": "RB-A0 (가상 로봇 컨트롤러 보드 rev A0)",
  "_note": "레일 min/max 는 레귤레이터 정확도 + 부하 변동 + IR drop 을 합친 보드 전원 설계값. switchable 레일은 저전력 모드에서 꺼진다. off_load_ohm = 꺼진 레일의 등가 부하(그 레일의 칩 내부 + 다른 부하, DC 근사).",
  "rails": {
    "VDD_1V8":      {"nom": 1.8, "min": 1.71,  "max": 1.89},
    "VDD_3V3":      {"nom": 3.3, "min": 3.135, "max": 3.465},
    "VDD_3V0":      {"nom": 3.0, "min": 2.85,  "max": 3.15},
    "VDD_3V3_SNS":  {"nom": 3.3, "min": 3.036, "max": 3.564},
    "VDD_3V3_GNSS": {"nom": 3.3, "min": 3.135, "max": 3.465, "switchable": true, "off_load_ohm": 1000}
  },
  "links": [
    {"id": "L1", "net": "UART3_RX", "desc": "MCU TX -> SoC RX, 3.3V -> 1.8V 직결",
     "topology": "direct", "i_load_ma": 0.1, "r_series_ohm": 0,
     "driver": {"part": "MCU33_GPIO", "rail": "VDD_3V3"}, "receiver": {"part": "SOC18_GPIO", "rail": "VDD_1V8"}},
    {"id": "L2", "net": "UART3_TX", "desc": "SoC TX -> MCU RX, 1.8V -> 3.3V 직결",
     "topology": "direct", "i_load_ma": 0.1, "r_series_ohm": 0,
     "driver": {"part": "SOC18_GPIO", "rail": "VDD_1V8"}, "receiver": {"part": "MCU33_GPIO", "rail": "VDD_3V3"}},
    {"id": "L3", "net": "I2C2_SDA", "desc": "SoC <-> IMU, open-drain FET 레벨시프터 (AN10441 구조), 양쪽 4.7k 풀업",
     "topology": "od_fet",
     "fet": {"vgs_th_max": 1.0, "rds_on_ohm": 5.0, "rds_on_vgs": 1.5},
     "a": {"part": "SOC18_GPIO", "rail": "VDD_1V8", "pullup_ohm": 4700},
     "b": {"part": "SENS33_IO", "rail": "VDD_3V3_SNS", "pullup_ohm": 4700}},
    {"id": "L4", "net": "UART2_TX", "desc": "MCU TX(idle High) -> GNSS RX 직결, GNSS 레일은 슬립 때 OFF",
     "topology": "direct", "i_load_ma": 0.1, "r_series_ohm": 0,
     "driver": {"part": "MCU33_GPIO", "rail": "VDD_3V3"}, "receiver": {"part": "GNSS_IO", "rail": "VDD_3V3_GNSS"}},
    {"id": "L5", "net": "UART2_TX_BUF", "desc": "L4 수정안: MCU TX -> Ioff 버퍼(GNSS 레일) -> GNSS RX",
     "topology": "direct", "i_load_ma": 0.1, "r_series_ohm": 0,
     "driver": {"part": "MCU33_GPIO", "rail": "VDD_3V3"}, "receiver": {"part": "BUF_IOFF_3V3", "rail": "VDD_3V3_GNSS"}},
    {"id": "L6", "net": "IMU_CS_N", "desc": "MCU VDDIO2 뱅크(VDD_3V0) -> IMU CS, 다른 3.3V 레일",
     "topology": "direct", "i_load_ma": 0.1, "r_series_ohm": 0,
     "driver": {"part": "MCU33_GPIO", "rail": "VDD_3V0"}, "receiver": {"part": "SENS33_IO", "rail": "VDD_3V3_SNS"}}
