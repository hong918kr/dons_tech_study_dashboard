/* uart_regs.def — "include 방식" X-macro 목록. 포함하기 전에 UART_REG(name, ofs, rst, acc) 를 정의할 것.
 * 의도적으로 include guard 가 없다: 여러 번 포함되는 것이 목적이다. */
#ifndef UART_REG
#error "define UART_REG(name, ofs, rst, acc) before including uart_regs.def"
#endif
UART_REG(CR1,    0x00u, 0x00000000u, ACC_RW)
UART_REG(CR2,    0x04u, 0x00000000u, ACC_RW)
UART_REG(SR,     0x0Cu, 0x000000C0u, ACC_W1C)
UART_REG(ID,     0x1Cu, 0x00A70011u, ACC_RO)
#undef UART_REG
