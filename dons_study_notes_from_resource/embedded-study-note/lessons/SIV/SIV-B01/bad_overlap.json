{
  "block": "SPI0",
  "desc": "SPI master/slave controller (가상 IP, SIV 트랙 공용 예제)",
  "version": "1.1-draft",
  "base": "0x40013000",
  "size": "0x40",
  "registers": [
    {"name": "ID", "offset": "0x000", "desc": "IP 식별자", "reset": "0x53500102",
     "fields": [
       {"name": "PART",  "bits": "31:16", "access": "RO", "reset": "0x5350"},
       {"name": "MAJOR", "bits": "15:8",  "access": "RO", "reset": "0x01"},
       {"name": "MINOR", "bits": "7:0",   "access": "RO", "reset": "0x02"}]},
    {"name": "CTRL", "offset": "0x004", "desc": "제어", "reset": "0x00070302",
     "fields": [
       {"name": "EN",       "bits": "0",     "access": "RW", "reset": 0},
       {"name": "MSTR",     "bits": "1",     "access": "RW", "reset": 1},
       {"name": "CPOL",     "bits": "2",     "access": "RW", "reset": 0},
       {"name": "CPHA",     "bits": "3",     "access": "RW", "reset": 0},
       {"name": "LSBF",     "bits": "4",     "access": "RW", "reset": 0},
       {"name": "LOOPBACK", "bits": "5",     "access": "RW", "reset": 0},
       {"name": "CLKDIV",   "bits": "11:4",  "access": "RW", "reset": "0x3"},
       {"name": "FSIZE",    "bits": "20:16", "access": "RW", "reset": "0x7"}]},
    {"name": "STATUS", "offset": "0x008", "desc": "상태 (HW가 갱신)",
     "fields": [
       {"name": "BUSY", "bits": "0", "access": "RO", "reset": 0, "volatile": true},
       {"name": "TXE",  "bits": "1", "access": "RO", "reset": 1, "volatile": true},
       {"name": "RXNE", "bits": "2", "access": "RO", "reset": 0, "volatile": true},
       {"name": "TXF",  "bits": "3", "access": "RO", "reset": 0, "volatile": true}]},
    {"name": "INT_RAW", "offset": "0x00C", "desc": "인터럽트 raw status (W1C)",
     "fields": [
       {"name": "TXDONE", "bits": "0", "access": "W1C", "reset": 0, "volatile": true},
       {"name": "RXOVF",  "bits": "1", "access": "W1C", "reset": 0, "volatile": true},
       {"name": "MODF",   "bits": "2", "access": "W1C", "reset": 0, "volatile": true}]},
    {"name": "INT_EN", "offset": "0x010", "desc": "인터럽트 enable",
     "fields": [
       {"name": "TXDONE", "bits": "0", "access": "RW", "reset": 0},
       {"name": "RXOVF",  "bits": "1", "access": "RW", "reset": 0},
       {"name": "MODF",   "bits": "2", "access": "RW", "reset": 0}]},
    {"name": "INT_STAT", "offset": "0x014", "desc": "masked status = RAW & EN",
     "fields": [
       {"name": "TXDONE", "bits": "0", "access": "RO", "reset": 0, "volatile": true},
       {"name": "RXOVF",  "bits": "1", "access": "RO", "reset": 0, "volatile": true},
       {"name": "MODF",   "bits": "2", "access": "RO", "reset": 0, "volatile": true}]},
    {"name": "INT_FORCE", "offset": "0x018", "desc": "인터럽트 강제 트리거 (테스트용, 읽으면 0)",
     "fields": [
       {"name": "TXDONE", "bits": "0", "access": "WO", "reset": 0},
       {"name": "RXOVF",  "bits": "1", "access": "WO", "reset": 0},
       {"name": "MODF",   "bits": "2", "access": "WO", "reset": 0}]},
    {"name": "TXDATA", "offset": "0x01C", "desc": "TX FIFO push",
     "fields": [
       {"name": "DATA", "bits": "31:0", "access": "WO", "reset": 0}]},
    {"name": "RXDATA", "offset": "0x020", "desc": "RX FIFO pop",
     "fields": [
       {"name": "DATA", "bits": "31:0", "access": "RO", "reset": 0, "volatile": true}]},
    {"name": "FIFO_LVL", "offset": "0x024", "desc": "FIFO 채움 수준",
     "fields": [
       {"name": "TXLVL", "bits": "3:0",  "access": "RO", "reset": 0, "volatile": true},
       {"name": "RXLVL", "bits": "11:8", "access": "RO", "reset": 0, "volatile": true}]},
    {"name": "CS_CTRL", "offset": "0x028", "desc": "chip-select 제어",
     "fields": [
       {"name": "CS0_EN",  "bits": "0",    "access": "RW", "reset": 0},
       {"name": "CS1_EN",  "bits": "1",    "access": "RW", "reset": 0},
       {"name": "CS_POL",  "bits": "7:4",  "access": "RW", "reset": 0},
       {"name": "CS_HOLD", "bits": "15:8", "access": "RW", "reset": "0x04"}]},
    {"name": "ERR_CNT", "offset": "0x02C", "desc": "에러 카운터 (읽으면 0)",
     "fields": [
       {"name": "OVR",  "bits": "7:0",  "access": "RC", "reset": 0, "volatile": true},
       {"name": "MODF", "bits": "15:8", "access": "RC", "reset": 0, "volatile": true}]},
    {"name": "DMA_CTRL", "offset": "0x030", "desc": "DMA 요청 제어",
     "fields": [
       {"name": "TXDMAEN", "bits": "0",     "access": "RW", "reset": 0},
       {"name": "RXDMAEN", "bits": "1",     "access": "RW", "reset": 0},
       {"name": "TXTHR",   "bits": "11:8",  "access": "RW", "reset": "0x4"},
       {"name": "RXTHR",   "bits": "19:16", "access": "RW", "reset": "0x1"}]},
    {"name": "SCRATCH", "offset": "0x03C", "desc": "SW 스크래치 (버스 sanity 용)",
     "fields": [
       {"name": "VAL", "bits": "31:0", "access": "RW", "reset": 0}]}
  ]
}
