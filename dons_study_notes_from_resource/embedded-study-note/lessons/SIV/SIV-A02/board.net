# VAL-R2 센서 캐리어 보드 넷리스트 (가상)
# 형식: NET  ref.pin ...  [pull=0|1]   ·  !hold NET 값  = 패턴 금지 넷
# U1/U2/U3 만 BSDL 이 있다. R*, X*, TP*, U7 은 스캔이 없는 부품.
DATA0 U1.10 U2.B1 pull=1
DATA1 U1.11 U2.B2 pull=1
DATA2 U1.12 U2.B3 pull=1
DATA3 U1.13 U2.B4 pull=1
DATA4 U1.14 U2.B5 pull=1
DATA5 U1.15 U2.B6 pull=1
DATA6 U1.16 U2.B7 pull=1
DATA7 U1.17 U2.B8 pull=1
DATA8 U1.18 U2.B9 pull=1
DATA9 U1.19 U2.B10 pull=1
DATA10 U1.20 U2.B11 pull=1
DATA11 U1.21 U2.B12 pull=1
DATA12 U1.22 U2.B13 pull=1
DATA13 U1.23 U2.B14 pull=1
DATA14 U1.24 U2.B15 pull=1
DATA15 U1.25 U2.B16 pull=1
ADDR0 U1.30 U2.C1 U3.12
ADDR1 U1.31 U2.C2 U3.11
ADDR2 U1.32 U2.C3 U3.10
ADDR3 U1.33 U2.C4 U3.9
ADDR4 U1.34 U2.C5 U3.8
ADDR5 U1.35 U2.C6 U3.7
ADDR6 U1.36 U2.C7 U3.6
ADDR7 U1.37 U2.C8 U3.5
nCS U1.40 U2.D1 R10.1 pull=1
nWE U1.41 U2.D2 R11.1 pull=1
nOE U1.42 U2.D3 R12.1 pull=1
BUF0 U3.20 U2.E1
BUF1 U3.19 U2.E2
BUF2 U3.18 U2.E3
BUF3 U3.17 U2.E4
BUF4 U3.16 U2.E5
BUF5 U3.15 U2.E6
BUF6 U3.14 U2.E7
BUF7 U3.13 U2.E8
IRQ_N U2.F1 U1.43 R21.1 pull=1
RST_N U2.F2 U1.45 R22.1 pull=1
PMIC_EN U1.44 U7.2
CLK_25M X1.3 U2.F3
TP_VSENSE TP4.1 R30.2
!hold RST_N 1
!hold PMIC_EN 1
