-- 가상 부품 LVL_BUF (SIV-A02 실습용, gen_board.py 가 생성)
entity LVL_BUF is
  generic (PHYSICAL_PIN_MAP : string := "PKG");
  port (
    TCK : in bit;
    TMS : in bit;
    TDI : in bit;
    TDO : out bit;
    A : in bit_vector(7 downto 0);
    B : out bit_vector(7 downto 0)
  );
  use STD_1149_1_2001.all;
  attribute COMPONENT_CONFORMANCE of LVL_BUF : entity is "STD_1149_1_2001";
  attribute PIN_MAP of LVL_BUF : entity is PHYSICAL_PIN_MAP;
  constant PKG : PIN_MAP_STRING :=
    "TCK:1, TMS:2, TDI:3, TDO:4, A:(12,11,10,9,8,7,6,5), B:(20,19,18,17,16,15,14,13)";
  attribute TAP_SCAN_IN of TDI : signal is true;
  attribute TAP_SCAN_OUT of TDO : signal is true;
  attribute TAP_SCAN_MODE of TMS : signal is true;
  attribute TAP_SCAN_CLOCK of TCK : signal is (10.0e6, BOTH);
  attribute INSTRUCTION_LENGTH of LVL_BUF : entity is 3;
  attribute INSTRUCTION_OPCODE of LVL_BUF : entity is
    "BYPASS (111)," &
    "EXTEST (000)," &
    "SAMPLE (001)," &
    "PRELOAD (001)";
  attribute BOUNDARY_LENGTH of LVL_BUF : entity is 17;
  attribute BOUNDARY_REGISTER of LVL_BUF : entity is
    -- num (cell, port, function, safe [, ccell, disval, rslt])
    "0 (BC_1, *, control, 0)," &
    "1 (BC_1, B(0), output3, X, 0, 0, Z)," &
    "2 (BC_1, B(1), output3, X, 0, 0, Z)," &
    "3 (BC_1, B(2), output3, X, 0, 0, Z)," &
    "4 (BC_1, B(3), output3, X, 0, 0, Z)," &
    "5 (BC_1, B(4), output3, X, 0, 0, Z)," &
    "6 (BC_1, B(5), output3, X, 0, 0, Z)," &
    "7 (BC_1, B(6), output3, X, 0, 0, Z)," &
    "8 (BC_1, B(7), output3, X, 0, 0, Z)," &
    "9 (BC_1, A(0), input, X)," &
    "10 (BC_1, A(1), input, X)," &
    "11 (BC_1, A(2), input, X)," &
    "12 (BC_1, A(3), input, X)," &
    "13 (BC_1, A(4), input, X)," &
    "14 (BC_1, A(5), input, X)," &
    "15 (BC_1, A(6), input, X)," &
    "16 (BC_1, A(7), input, X)";
end LVL_BUF;
