-- 가상 부품 IO_FPGA (SIV-A02 실습용, gen_board.py 가 생성)
entity IO_FPGA is
  generic (PHYSICAL_PIN_MAP : string := "PKG");
  port (
    TCK : in bit;
    TMS : in bit;
    TDI : in bit;
    TDO : out bit;
    D : inout bit_vector(0 to 15);
    A : in bit_vector(0 to 7);
    nCS : in bit;
    nWE : in bit;
    nOE : in bit;
    Y : in bit_vector(0 to 7);
    IRQ : out bit;
    RST_OUT : out bit;
    CLK : in bit;
    SPARE : inout bit_vector(0 to 3)
  );
  use STD_1149_1_2001.all;
  attribute COMPONENT_CONFORMANCE of IO_FPGA : entity is "STD_1149_1_2001";
  attribute PIN_MAP of IO_FPGA : entity is PHYSICAL_PIN_MAP;
  constant PKG : PIN_MAP_STRING :=
    "TCK:A1, TMS:A2, TDI:A3, TDO:A4, D:(B1,B2,B3,B4,B5,B6,B7,B8,B9,B10,B11,B12,B13,B14,B15,B16), A:(C1,C2,C3,C4,C5,C6,C7,C8), " &
    "nCS:D1, nWE:D2, nOE:D3, Y:(E1,E2,E3,E4,E5,E6,E7,E8), IRQ:F1, RST_OUT:F2, " &
    "CLK:F3, SPARE:(G1,G2,G3,G4)";
  attribute TAP_SCAN_IN of TDI : signal is true;
  attribute TAP_SCAN_OUT of TDO : signal is true;
  attribute TAP_SCAN_MODE of TMS : signal is true;
  attribute TAP_SCAN_CLOCK of TCK : signal is (10.0e6, BOTH);
  attribute INSTRUCTION_LENGTH of IO_FPGA : entity is 6;
  attribute INSTRUCTION_OPCODE of IO_FPGA : entity is
    "BYPASS (111111)," &
    "EXTEST (100110)," &
    "SAMPLE (000101)," &
    "PRELOAD (000101)," &
    "IDCODE (001001)";
  attribute BOUNDARY_LENGTH of IO_FPGA : entity is 63;
  attribute BOUNDARY_REGISTER of IO_FPGA : entity is
    -- num (cell, port, function, safe [, ccell, disval, rslt])
    "0 (BC_1, *, control, 1)," &
    "1 (BC_7, D(0), bidir, X, 0, 1, Z)," &
    "2 (BC_1, *, control, 1)," &
    "3 (BC_7, D(1), bidir, X, 2, 1, Z)," &
    "4 (BC_1, *, control, 1)," &
    "5 (BC_7, D(2), bidir, X, 4, 1, Z)," &
    "6 (BC_1, *, control, 1)," &
    "7 (BC_7, D(3), bidir, X, 6, 1, Z)," &
    "8 (BC_1, *, control, 1)," &
    "9 (BC_7, D(4), bidir, X, 8, 1, Z)," &
    "10 (BC_1, *, control, 1)," &
    "11 (BC_7, D(5), bidir, X, 10, 1, Z)," &
    "12 (BC_1, *, control, 1)," &
    "13 (BC_7, D(6), bidir, X, 12, 1, Z)," &
    "14 (BC_1, *, control, 1)," &
    "15 (BC_7, D(7), bidir, X, 14, 1, Z)," &
    "16 (BC_1, *, control, 1)," &
    "17 (BC_7, D(8), bidir, X, 16, 1, Z)," &
    "18 (BC_1, *, control, 1)," &
    "19 (BC_7, D(9), bidir, X, 18, 1, Z)," &
    "20 (BC_1, *, control, 1)," &
    "21 (BC_7, D(10), bidir, X, 20, 1, Z)," &
    "22 (BC_1, *, control, 1)," &
    "23 (BC_7, D(11), bidir, X, 22, 1, Z)," &
    "24 (BC_1, *, control, 1)," &
    "25 (BC_7, D(12), bidir, X, 24, 1, Z)," &
    "26 (BC_1, *, control, 1)," &
    "27 (BC_7, D(13), bidir, X, 26, 1, Z)," &
    "28 (BC_1, *, control, 1)," &
    "29 (BC_7, D(14), bidir, X, 28, 1, Z)," &
    "30 (BC_1, *, control, 1)," &
    "31 (BC_7, D(15), bidir, X, 30, 1, Z)," &
    "32 (BC_1, A(0), input, X)," &
    "33 (BC_1, A(1), input, X)," &
    "34 (BC_1, A(2), input, X)," &
    "35 (BC_1, A(3), input, X)," &
    "36 (BC_1, A(4), input, X)," &
    "37 (BC_1, A(5), input, X)," &
    "38 (BC_1, A(6), input, X)," &
    "39 (BC_1, A(7), input, X)," &
    "40 (BC_1, nCS, input, X)," &
    "41 (BC_1, nWE, input, X)," &
    "42 (BC_1, nOE, input, X)," &
    "43 (BC_1, Y(0), input, X)," &
    "44 (BC_1, Y(1), input, X)," &
    "45 (BC_1, Y(2), input, X)," &
    "46 (BC_1, Y(3), input, X)," &
    "47 (BC_1, Y(4), input, X)," &
    "48 (BC_1, Y(5), input, X)," &
    "49 (BC_1, Y(6), input, X)," &
    "50 (BC_1, Y(7), input, X)," &
    "51 (BC_1, IRQ, output2, 1)," &
    "52 (BC_1, *, control, 1)," &
    "53 (BC_1, RST_OUT, output3, 1, 52, 1, Z)," &
    "54 (BC_4, CLK, clock, X)," &
    "55 (BC_1, *, control, 1)," &
    "56 (BC_7, SPARE(0), bidir, X, 55, 1, Z)," &
    "57 (BC_1, *, control, 1)," &
    "58 (BC_7, SPARE(1), bidir, X, 57, 1, Z)," &
    "59 (BC_1, *, control, 1)," &
    "60 (BC_7, SPARE(2), bidir, X, 59, 1, Z)," &
    "61 (BC_1, *, control, 1)," &
    "62 (BC_7, SPARE(3), bidir, X, 61, 1, Z)";
end IO_FPGA;
